# The API this site reads. Nothing else talks to the platform.
NPI_API_BASE_URL=https://stg.list-smarter.com

# Customer data base: staging includes /api; production uses https://api.npimark.com.
NPI_PUBLIC_API_BASE_URL=https://stg.list-smarter.com/api

# Staging account origin below. In production, set a private backend origin reachable
# by the Next.js server over the internal network or tailnet. Never use npimark.com
# (routes back to the site) or api.npimark.com (no account/session routes).
# This value is server-only; never prefix it NEXT_PUBLIC_.
NPI_ACCOUNT_API_BASE_URL=https://stg.list-smarter.com/api

# A key issued in the admin app with the providers.read scope and nothing more.
# Server-side only - never prefix this NEXT_PUBLIC_, or it ships to the browser.
NPI_API_KEY=

# Where this build is served from, for canonical URLs and link previews.
SITE_BASE_URL=http://localhost:3000

# Indexing is off everywhere except the host that is meant to be found. Set to "true"
# only on production, and only once the domain and the data-use review are settled.
# It also gates IndexNow: nothing is ever submitted from a host that is not indexable.
SITE_INDEXABLE=false

# Search Console and Bing verification tokens, and the IndexNow key. All three are off when blank,
# which is the right state for a development copy. See infra/site.env.example for what each one is
# and docs/deployment.md "Getting found" for where to get them.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
