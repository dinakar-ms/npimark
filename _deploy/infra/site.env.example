# /etc/npi-v5/site.env - what the public site is given, and nothing more.
#
# Kept apart from app.env on purpose. The site is a customer: it holds one API key with
# providers.read, and a key in this file cannot widen itself into anything the admin app can do.
# Create the key in the admin app under API keys, paste it here, and `chmod 600` the file.

NPI_API_KEY=npi_live_replace_me

# Only if the site should read an API other than the one in this compose project.
# NPI_API_BASE_URL=http://api:8000

# Cloudflare Turnstile site key, for the human check on sign-up and forgot-password. Blank (the
# default) shows no widget. Set it together with TURNSTILE_SECRET_KEY in app.env - never one
# without the other. docs/deployment.md "Turnstile" says where to create both.
TURNSTILE_SITE_KEY=

# The Terms of Service and Privacy Policy are drafts until counsel signs them off. While this is
# anything but "true" both pages carry a "Draft - under legal review" banner and show counsel's
# open questions inline. The owner sets it to true (then restarts the site) once the text is
# approved. Read at request time; no rebuild. The text is in site/src/content/legal/.
LEGAL_PAGES_APPROVED=false

# The mailboxes the legal pages and the removal form name. Somebody must be reading them from
# launch day: the Privacy Policy tells people to write to PRIVACY_EMAIL to have their details
# removed. Blank shows a neutral phrase instead of an address.
PRIVACY_EMAIL=
SUPPORT_EMAIL=

# The other two mailboxes /contact publishes. Blank prints no mailto at all - the sales route falls
# back to sign-up and the security route to the /security page - and the page says on itself that
# the address has not been set, so an unread address never ships in place of a working one.
# SECURITY_EMAIL is where /security tells a researcher to send a vulnerability report.
SALES_EMAIL=
SECURITY_EMAIL=

# Search Console and Bing Webmaster Tools verification tokens. Blank renders no tag and serves no
# file, which is what an unverified site should do. Both are read at run time, so setting one and
# recreating the site container is enough - no rebuild.
#
# GOOGLE_SITE_VERIFICATION is the content of the "HTML tag" Search Console offers, the token only.
# It renders as a meta tag on every page. A page that was prerendered when the image was built
# carries it from its next revalidation (an hour for the home page); Google's DNS-record method, in
# Cloudflare, is immediate and needs nothing here.
#
# BING_SITE_VERIFICATION is the token from Bing Webmaster Tools. It renders as a meta tag *and* is
# served at /BingSiteAuth.xml, which is generated per request and so is correct immediately.
#
# docs/deployment.md "Getting found" has the click-by-click.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow: how changed URLs reach Bing, Yandex, Seznam and Naver without waiting for a crawl.
# 8-128 characters of letters, digits and dashes - `openssl rand -hex 16` will do, or let Bing
# Webmaster Tools generate one. Blank means the feature is off: no key file is served and nothing
# is ever submitted. With a key set, the site serves /<key>.txt and every release runs
# `node scripts/indexnow.mjs` inside this container, which submits the site's own pages and its
# sitemaps - and submits nothing at all unless SITE_INDEXABLE is "true".
INDEXNOW_KEY=

# The company's own facts, answered without a deploy.
#
# site/src/content/company.ts declares the things only the owner knows as questions, and the
# company pages print the question, highlighted, wherever the answer is missing. Each one can be
# answered here instead of in the source: set the variable, restart the site, and the page prints
# the answer, the [OWNER: ...] note disappears, and once the last question on a page is answered
# that page is allowed back into the search index and the sitemap (see site/src/lib/draft.ts -
# while a page is still asking, it serves noindex and is not submitted).
#
# Three things worth knowing:
#   * blank means "no answer here", so the value committed in company.ts is used. An empty
#     variable never un-answers a question.
#   * a value set here wins over a committed one, so a wrong fact on a live page is a one-minute
#     fix rather than a release.
#   * the exact words `publish nothing` settle a question by removing the sentence it was in -
#     for a fact we have decided not to publish, which is an answer, not a silence.
#
# These carry answers, never prose. The site's copy stays in the repository under the tests and
# lint rules that protect it. Adding a question means adding a fact in company.ts; its variable
# name follows from the id, and site/src/content/answers.test.mjs fails if it is not listed here.

# the legal entity's exact name and state of organisation, and whether NPI Mark should be
# described as a trade name of it
# Answered in company.ts; set this only to correct or replace that answer.
COMPANY_LEGAL_ENTITY=

# which states Lorann LLC is registered as a data broker in — applications for California,
# Texas, Oregon and Vermont were filed by 2026-10-02 and are awaiting approval, so until each is
# granted this page must not say we are registered
COMPANY_DATA_BROKER_REGISTRATION=

# when the company was founded, or say to drop the sentence — we publish no date rather than an
# approximate one
COMPANY_FOUNDED=

# how to describe the size of the team, or say to drop the sentence — a made-up headcount is
# worse than none
COMPANY_TEAM_SIZE=

# the postal address to publish, or confirm that we publish none and say so here instead
COMPANY_OFFICE=

# a phone number for sales and support and the hours somebody answers it, or confirm there is
# none and that this page says email only
COMPANY_PHONE=

# whether any customer may be named on a public page, and in whose words — no name goes on this
# site without their written agreement
COMPANY_CUSTOMER_NAMES=

# whether there is an audit report, a certification or a third-party penetration test a buyer's
# security review may be pointed at — until you say there is, this page claims none
COMPANY_SECURITY_ASSURANCE=

# whether a security report can earn a reward, and on what terms — until you say so, this page
# says there is no programme to point a researcher at
COMPANY_SECURITY_REWARDS=

# Knowledge-base assistant: off until the shared budget volume and model are tested.
# Reuses OPENAI_API_KEY, NPI_AI_MODEL and NPI_AI_STATE_DIR from the search assistant.
# The state path must persist across deployments and be shared by every site replica.
# Public /help search works without AI configuration.
NPI_HELP_AI_ENABLED=false
